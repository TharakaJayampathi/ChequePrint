<!-- MAIN NAVIGATION -->
<!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
@{
    var userName = User.Identity.Name;
}

<style>
    .modal-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.7);
        z-index: 1051;
        display: none;
        justify-content: center;
        align-items: center;
    }

    .modal-overlay .spinner-border {
        z-index: 1052;
    }

    .input-group .select2-container {
        flex: 1 1 auto;
        width: 1% !important;
    }

    .input-group .select2-selection {
        height: calc(2.25rem + 2px);
    }
</style>

<div id="kt_header" class="header align-items-stretch" data-kt-sticky="true" data-kt-sticky-name="header" data-kt-sticky-offset="{default: '200px', lg: '300px'}">
    <!--begin::Container-->
    <div class="container-xxl d-flex align-items-center">
        <!--begin::Heaeder menu toggle-->
        <div class="d-flex align-items-center d-lg-none ms-n2 me-3" title="Show aside menu">
            <div class="btn btn-icon btn-custom w-30px h-30px w-md-40px h-md-40px" id="kt_header_menu_mobile_toggle">
                <span class="svg-icon svg-icon-2x">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M21 7H3C2.4 7 2 6.6 2 6V4C2 2.4 2.4 3 3 3H21C21.6 3 22 3.4 22 4V6C22 6.6 21.6 7 21 7Z" fill="black" />
                        <path opacity="0.3" d="M21 14H3C2.4 14 2 13.6 2 13V11C2 10.4 2.4 10 3 10H21C21.6 10 22 10.4 22 11V13C22 13.6 21.6 14 21 14ZM22 20V18C22 17.4 21.6 17 21 17H3C2.4 17 2 17.4 2 18V20C2 20.6 2.4 21 3 21H21C21.6 21 22 20.6 22 20Z" fill="black" />
                    </svg>
                </span>
            </div>
        </div>
        <!--end::Heaeder menu toggle-->
        
        <!--begin::Header Logo-->
        <div class="header-logo me-2 me-md-10 flex-grow-1 flex-lg-grow-0">
            <a href="~/dashboard">
                <img alt="Logo" src="~/img/cheque_print_v3.png" class="h-25px h-lg-30px logo-default" />
                <img alt="Logo" src="~/img/cheque_print_v3.png" class="h-25px h-lg-30px logo-sticky" />
            </a>
        </div>
        <!--end::Header Logo-->
        
        <!--begin::Wrapper-->
        <div class="d-flex align-items-stretch justify-content-between flex-lg-grow-1">
            <!--begin::Navbar-->
            <div class="d-flex align-items-stretch" id="kt_header_nav">
                <!--begin::Menu wrapper-->
                <div class="header-menu align-items-stretch" data-kt-drawer="true" data-kt-drawer-name="header-menu" data-kt-drawer-activate="{default: true, lg: false}" data-kt-drawer-overlay="true" data-kt-drawer-width="{default:'200px', '300px': '250px'}" data-kt-drawer-direction="start" data-kt-drawer-toggle="#kt_header_menu_mobile_toggle" data-kt-swapper="true" data-kt-swapper-mode="prepend" data-kt-swapper-parent="{default: '#kt_body', lg: '#kt_header_nav'}">
                    <!--begin::Menu-->
                    <div class="menu menu-lg-rounded menu-column menu-lg-row menu-state-bg menu-title-gray-700 menu-state-icon-primary menu-state-bullet-primary menu-arrow-gray-400 fw-bold my-5 my-lg-0 align-items-stretch" id="#kt_header_menu" data-kt-menu="true">

                        <!-- Dashboard -->
                        <div class="menu-item">
                            <a class="menu-link py-3" href="@Url.Action("Index", "Dashboard")">
                                <span class="menu-title">Dashboard</span>
                            </a>
                        </div>

                        <!-- Cheque Print -->
                        <div class="menu-item">
                            <a class="menu-link py-3" href="@Url.Action("Index", "ChequePrint")">
                                <span class="menu-title">Cheque Print</span>
                            </a>
                        </div>
                    </div>
                    <!--end::Menu-->
                </div>
                <!--end::Menu wrapper-->
            </div>
            <!--end::Navbar-->
            
            <!--begin::Topbar-->
            <div class="d-flex align-items-stretch flex-shrink-0">
                <!--begin::Toolbar wrapper-->
                <div class="topbar d-flex align-items-stretch flex-shrink-0">
                    <!-- User Profile -->
                    <div class="d-flex align-items-center ms-1 ms-lg-3" id="kt_header_user_menu_toggle">
                        <div class="cursor-pointer symbol symbol-30px symbol-md-40px" data-kt-menu-trigger="click" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-end">
                            <img alt="User" src="~/assets/media/avatars/150-26.jpg" />
                        </div>

                        <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg menu-state-primary fw-bold py-4 fs-6 w-275px" data-kt-menu="true">
                            <div class="menu-item px-3">
                                <div class="menu-content d-flex align-items-center px-3">
                                    <div class="symbol symbol-50px me-5">
                                        <img alt="User" src="~/assets/media/avatars/150-26.jpg" />
                                    </div>
                                    <div class="d-flex flex-column">
                                        <div class="fw-bolder d-flex align-items-center fs-5">
                                            Hello,
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="separator my-2"></div>

                            <div class="menu-item px-5">
                                <a href="#" class="menu-link px-0 bg-white">
                                    @ViewBag.LoggedUserData?.FullName ?? User.Identity.Name
                                </a>
                                <small class="text-muted" style="word-wrap: break-word;">@User.Identity.Name</small>
                            </div>

                            <div class="separator my-2"></div>
                            
                            <div class="menu-item px-5">
                                <form id="logoutForm" asp-action="Logout" asp-controller="Auth" class="navbar-right">
                                    <a class="menu-link px-5 justify-content-center" href="#" data-toggle="modal" data-target="#logoutModal">
                                        <i class="fas fa-power-off"></i> &nbsp; Logout
                                    </a>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <!--end::Toolbar wrapper-->
            </div>
            <!--end::Topbar-->
        </div>
        <!--end::Wrapper-->
    </div>
    <!--end::Container-->
</div>

<script>
    document.getElementById('confirmLogoutButton').addEventListener('click', function () {
        document.getElementById('logoutForm').submit();
    });

    // Initialize search modal
    document.getElementById('btnOpenSearchModalNav').addEventListener('click', function() {
        $('#searchModalNav').modal('show');
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
<script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>

<script>
    function initializeDateRangePicker() {
        document.getElementById('invoiceDateFromNav').value = '';
        document.getElementById('invoiceDateToNav').value = '';
        $('#searchreportrangeNav').daterangepicker({
            autoUpdateInput: false,
            opens: 'right',
            locale: {
                cancelLabel: 'Clear',
                format: 'MM/DD/YYYY'
            },
            ranges: {
                'Today': [moment(), moment()],
                'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                'This Month': [moment().startOf('month'), moment().endOf('month')],
                'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
            }
        });
        $('#searchreportrangeNav').on('apply.daterangepicker', function (ev, picker) {
            $(this).val(picker.startDate.format('MM/DD/YYYY') + ' - ' + picker.endDate.format('MM/DD/YYYY'));
            document.getElementById('invoiceDateFromNav').value = picker.startDate.format('YYYY-MM-DD');
            document.getElementById('invoiceDateToNav').value = picker.endDate.format('YYYY-MM-DD');
        });
        $('#searchreportrangeNav').on('cancel.daterangepicker', function (ev, picker) {
            $(this).val('');
            document.getElementById('invoiceDateFromNav').value = '';
            document.getElementById('invoiceDateToNav').value = '';
        });
        $('#searchreportrangeNav').val('');
    }

    initializeDateRangePicker();
</script>