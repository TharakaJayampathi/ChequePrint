@{
    ViewBag.Title = "Cheque Print";
    Layout = "~/Views/Shared/Nifty/_Layout.cshtml";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<!-- Select2 CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/css/select2.min.css" rel="stylesheet" />

<div class="toolbar py-5 py-lg-10" id="kt_toolbar">
    <div id="kt_toolbar_container" class="container-xxl d-flex flex-stack flex-wrap">
        <div class="page-title d-flex flex-column">
            <h3 class="text-white fw-bolder fs-2qx me-5">Cheque Print</h3>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-1">
                <li class="breadcrumb-item text-white opacity-75">
                    <a href="~/dashboard" class="text-white text-hover-primary">
                        Dashboard
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <span class="bullet bg-white opacity-75 w-5px h-2px"></span>
                </li>
                <li class="breadcrumb-item text-white opacity-75">
                    <a href="#" class="text-white text-hover-primary">
                        Cheque Print
                    </a>
                </li>
            </ul>
        </div>
        <div class="d-flex align-items-center flex-wrap py-2">
        </div>
    </div>
</div>

<div id="kt_content_container" class="d-flex flex-column-fluid align-items-start container-xxl">
    <div class="content flex-row-fluid" id="kt_content">
        <div class="card mr-2">
            <div class="card-body" id="divCheckPrint">
                <form id="formCheckPrint">
                    <br />
                    <br />
                    <div class="collapse show">
                        <div class="container-fluid px-0">
                            <div class="row">
                                <div class="col-lg-6" id="divPaymentMethodDropdown">
                                    <div class="form-group row my-5">
                                        <label id="lblPaymentMethodDropdown" class="col-lg-4 col-form-label mandatoryField">Payment Method</label>
                                        <div class="col-lg-6">
                                            <select id="selectPaymentMethod" class="form-control">
                                                <option value="">- Please Select -</option>
                                                <option value="1">Cash</option>
                                                <option value="2">Credit</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-6" id="divChequeName">
                                    <div class="form-group row my-5">
                                        <label id="lblChequeName" class="col-lg-4 col-form-label mandatoryField">Cheque Name</label>
                                        <div class="col-lg-6">
                                            <input class="form-control" id="txtChequeName" type="text" placeholder="Cheque Name" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6" id="divDate">
                                    <div class="form-group row my-5">
                                        <label id="lblDate" class="col-lg-4 col-form-label mandatoryField">Date</label>
                                        <div class="col-lg-6">
                                            <input class="form-control" id="txtDate" type="date" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6" id="divAmount">
                                    <div class="form-group row my-5">
                                        <label id="lblQty" class="col-lg-4 col-form-label mandatoryField">Amount</label>
                                        <div class="col-lg-6">
                                            <input class="form-control" id="txtAmount" type="number" placeholder="0" step="0.01" min="0">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <br>
                        </div>
                    </div>
                </form>
            </div>
            <div class="card-footer">
                <div class="row justify-content-end">
                    <div class="col">
                    </div>
                    <div class="col-auto">
                        <button type="button" id="btnPrint" class="btn btn-block btn-primary" style="width:125px;">
                            <i class="bi bi-save" aria-hidden="true"></i> Print
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    #formCreate .select2-container {
        z-index: 10000;
        width: 100% !important;
    }
    div.container {
        max-width: 1200px
    }
    /*.fa {
                height: 20px;
                margin-top: -5px;
            }*/
    .fa-edit {
        height: 20px;
        width: 5px;
        margin-top: -4px;
    }
    .fa-times {
        height: 20px;
        width: 5px;
        margin-top: -7px;
    }

    .fa-ban {
        height: 20px;
        width: 5px;
        margin-top: -4px;
    }

    .fa-check {
        height: 20px;
        width: 5px;
        margin-top: -4px;
    }
    label {
        color: black;
    }
</style>

@section scripts {
    <!-- Select2 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/js/select2.min.js"></script>
    <script src="~/js/chequeprint/cheque-print-form.js" asp-append-version="true"></script>
}