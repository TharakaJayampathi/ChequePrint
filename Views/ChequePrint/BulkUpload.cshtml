@{
    ViewBag.Title = "Cheque Print";
    Layout = "~/Views/Shared/Nifty/_Layout.cshtml";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<!-- Select2 CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/css/select2.min.css" rel="stylesheet" />

<div class="toolbar py-5 py-lg-10" id="kt_toolbar">
    <div id="kt_toolbar_container" class="container-xxl d-flex flex-stack flex-wrap">
        <div class="page-title d-flex flex-column">
            <h3 class="text-white fw-bolder fs-2qx me-5">Cheque Print</h3>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-1">
                <li class="breadcrumb-item text-white opacity-75">
                    <a href="~/dashboard" class="text-white text-hover-primary">
                        Dashboard
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <span class="bullet bg-white opacity-75 w-5px h-2px"></span>
                </li>
                <li class="breadcrumb-item text-white opacity-75">
                    <a href="#" class="text-white text-hover-primary">
                        Cheque Print
                    </a>
                </li>
            </ul>
        </div>
        <div class="d-flex align-items-center flex-wrap py-2">
        </div>
    </div>
</div>

<div id="kt_content_container" class="d-flex flex-column-fluid align-items-start container-xxl">
    <div class="content flex-row-fluid" id="kt_content">
        <div id="placeHolder"></div>
        <div class="card">
            <br>
            <br>
            <div class="card-body">
                <form id="formFileUpload">
                    <h2>Cheque Print Upload</h2>
                    <br>
                    <br>
                    <div class="row">
                        <div class="col-md-4">
                            <input id="txtAttachment" type="file" class="form-control" name="file" accept=".xlsx" />
                        </div>
                        <div class="col-md-4 mr-5">
                            <button type="button" class="btn btn-primary mr-5" id="btnAddAttachment">
                                Upload
                            </button>
                        </div>
                    </div>
                    <br>
                    <br>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="pageOverlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:linear-gradient(135deg, rgba(44,62,80,0.92), rgba(52,73,94,0.92)); backdrop-filter:blur(8px); z-index:9999;">
    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); text-align:center;">        
        <div style="width:80px; height:80px; margin:0 auto 25px; border:4px solid rgba(255,255,255,0.1); border-top:4px solid #3498db; border-right:4px solid #2ecc71; border-radius:50%; animation: spin 1s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite;"></div>        
        <div style="color:#ecf0f1; font-family:'Segoe UI', Arial, sans-serif; font-size:22px; font-weight:300; letter-spacing:3px; margin-bottom:8px;">Loading</div>       
        <div style="display:flex; justify-content:center; gap:8px;">
            <div style="width:10px; height:10px; background:#3498db; border-radius:50%; animation: bounce 1.4s ease-in-out 0s infinite both;"></div>
            <div style="width:10px; height:10px; background:#2ecc71; border-radius:50%; animation: bounce 1.4s ease-in-out 0.2s infinite both;"></div>
            <div style="width:10px; height:10px; background:#e74c3c; border-radius:50%; animation: bounce 1.4s ease-in-out 0.4s infinite both;"></div>
            <div style="width:10px; height:10px; background:#f39c12; border-radius:50%; animation: bounce 1.4s ease-in-out 0.6s infinite both;"></div>
        </div>        
        <div style="color:rgba(255,255,255,0.5); font-family:'Segoe UI', Arial, sans-serif; font-size:13px; margin-top:20px; letter-spacing:1px;">PLEASE WAIT</div>
    </div>
</div>

<style>
    #formCreate .select2-container {
    z-index: 10000;
    width: 100% !important;
    }

    div.container {
    max-width: 1200px
    }
    /*.fa {
    height: 20px;
    margin-top: -5px;
    }*/
    .fa-edit {
    height: 20px;
    width: 5px;
    margin-top: -4px;
    }

    .fa-times {
    height: 20px;
    width: 5px;
    margin-top: -7px;
    }

    .fa-ban {
    height: 20px;
    width: 5px;
    margin-top: -4px;
    }

    .fa-check {
    height: 20px;
    width: 5px;
    margin-top: -4px;
    }

    label {
    color: black;
    }
</style>

<link href="~/css/loading-spinner.css" rel="stylesheet" />

@section scripts {
    <script src="~/js/chequeprint/cheque-print-bulk-upload.js" asp-append-version="true"></script>
}