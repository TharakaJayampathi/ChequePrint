@{
    ViewBag.Title = "Cheque Print";
    ViewData["Logo"] = Url.Content("~/lib/landing-page/finance-logo.png");
    Layout = "~/Views/Shared/Nifty/_Layout.cshtml";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<!-- Select2 CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/css/select2.min.css" rel="stylesheet" />

<div class="toolbar py-5 py-lg-10" id="kt_toolbar">
    <div id="kt_toolbar_container" class="container-xxl d-flex flex-stack flex-wrap">
        <div class="page-title d-flex flex-column">
            <h3 class="text-white fw-bolder fs-2qx me-5">Cheque Print</h3>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-1">
                <li class="breadcrumb-item text-white opacity-75">
                    <a href="~/dashboard" class="text-white text-hover-primary">
                        Dashboard
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <span class="bullet bg-white opacity-75 w-5px h-2px"></span>
                </li>
                <li class="breadcrumb-item text-white opacity-75">
                    <a href="#" class="text-white text-hover-primary">
                        Cheque Print
                    </a>
                </li>
            </ul>
        </div>
        <div class="d-flex align-items-center flex-wrap py-2">
        </div>
    </div>
</div>

<div id="kt_content_container" class="d-flex flex-column-fluid align-items-start container-xxl">
    <div class="content flex-row-fluid" id="kt_content">
        <div id="placeHolder"></div>
        <div class="card">
            <br>
            <br>
            <div class="card-body">
                <form id="formFileUpload" asp-action="CreateNewDivisionChampionDivisionFileUpload" asp-controller="DivisionChampionDivisionFileUpload" method="post" enctype="multipart/form-data">
                    <h2>Cheque Print Upload</h2>
                    <br>
                    <br>
                    <div class="row">
                        <div class="col-md-4">
                            <input id="txtAttachment" type="file" class="form-control" name="file" accept=".xlsx" />
                            <div class="spinner-border text-primary" id="lblSpinner" style="display: none;" role="status">
                                <span class="sr-only">Loading...</span>
                            </div>
                        </div>
                        <div class="col-md-4 mr-5">
                            <button type="submit" class="btn btn-primary mr-5" id="btnAddAttachment">Upload</button>
                        </div>
                    </div>
                    <br>
                    <br>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    #formCreate .select2-container {
        z-index: 10000;
        width: 100% !important;
    }
    div.container {
        max-width: 1200px
    }
    /*.fa {
                height: 20px;
                margin-top: -5px;
            }*/
    .fa-edit {
        height: 20px;
        width: 5px;
        margin-top: -4px;
    }
    .fa-times {
        height: 20px;
        width: 5px;
        margin-top: -7px;
    }

    .fa-ban {
        height: 20px;
        width: 5px;
        margin-top: -4px;
    }

    .fa-check {
        height: 20px;
        width: 5px;
        margin-top: -4px;
    }
    label {
        color: black;
    }
</style>

@section scripts {
    <script src="~/js/chequeprint/cheque-print.js" asp-append-version="true"></script>
}